#!/usr/bin/env bash
# Send stdin to the client computer's clipboard via OSC 52.
#
# Why not just `set -g set-clipboard on`:
#   tmux emits OSC 52 with an EMPTY selection parameter (`ESC ] 52 ; ; <b64>`).
#   mosh's parser only accepts the `c` selection (`ESC ] 52 ; c ; <b64>` - see
#   the check in mosh's parse of OSC_string), so it silently drops everything
#   tmux sends. tmux cannot be configured around this: its `Ms` terminfo string
#   must consume both %p1 (selection) and %p2 (payload), and tmux always passes
#   an empty %p1 for its own copies, so a hardcoded `;c;` string makes tmux emit
#   nothing at all. Writing the sequence ourselves is the way out.
#
# Why write to a specific tty instead of stdout:
#   Inside the tmux-claude-session-manager popup, stdout lands in the popup,
#   whose bytes tmux would re-emit with its own (empty-selection) Ms - dropped
#   by mosh again. Writing straight to the outer client's tty hands the bytes to
#   mosh-server directly, which stores them and syncs them to mosh-client, which
#   re-emits OSC 52 to kitty, which writes the real system clipboard.
set -uo pipefail

payload="$(base64 | tr -d '\n')"
[ -n "$payload" ] || exit 0

# Terminals cap OSC 52 payloads; kitty's limit is generous but not unlimited.
# Fail loudly rather than truncating the user's clipboard silently.
if [ "${#payload}" -gt 74994 ]; then
    tmux display-message "osc52-copy: selection too large for OSC 52 (${#payload} b64 bytes); copied to tmux buffer only" 2>/dev/null
    exit 0
fi

# Outside tmux (plain ssh, or nvim launched without tmux) the controlling
# terminal already is the client terminal, so write straight to it.
if [ -z "${TMUX:-}" ]; then
    [ -w /dev/tty ] && printf '\033]52;c;%s\a' "$payload" > /dev/tty
    exit 0
fi

prefix="$(tmux show-option -gqv @claude_session_prefix 2>/dev/null)"
prefix="${prefix:-claude-}"

# Resolve the session that owns a real terminal, mirroring the popup handling in
# the hunk-review skill's resolve_host_session.sh.
current="$(tmux display-message -p '#S' 2>/dev/null || true)"
target_session="$current"

if [[ "$current" == "$prefix"* ]]; then
    origin="$(tmux show-options -qv -t "$current" @claude_origin 2>/dev/null || true)"
    if [ -n "$origin" ]; then
        target_session="$(tmux display-message -t "$origin" -p '#S' 2>/dev/null || echo "$current")"
    else
        target_session="$(tmux list-clients -F '#{session_name}' 2>/dev/null |
            awk -v p="$prefix" 'index($0, p) != 1 { print; exit }')"
        target_session="${target_session:-$current}"
    fi
fi

# Prefer a client attached to that session; fall back to any non-popup client.
ttys="$(tmux list-clients -t "$target_session" -F '#{client_tty}' 2>/dev/null)"
if [ -z "$ttys" ]; then
    ttys="$(tmux list-clients -F '#{client_tty} #{session_name}' 2>/dev/null |
        awk -v p="$prefix" 'index($2, p) != 1 { print $1 }')"
fi
[ -n "$ttys" ] || exit 0

seq_bytes="$(printf '\033]52;c;%s\a' "$payload")"
while read -r tty; do
    [ -w "$tty" ] || continue
    printf '%s' "$seq_bytes" > "$tty" 2>/dev/null
done <<< "$ttys"
